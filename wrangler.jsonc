{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crt-foxtang-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "crt.foxtang.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CACHE_TTL": "21600"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
